#!/system/bin/sh
# Root watchdog used only when initrc is unavailable.
case "$0" in
  */*) SCRIPT_DIR=${0%/*} ;;
  *)   SCRIPT_DIR=. ;;
esac
MODDIR=$(cd "$SCRIPT_DIR/.." 2>/dev/null && pwd || pwd)
DATA=/data/adb/dsh
mkdir -p "$DATA/run" "$DATA/logs"
echo -1000 > /proc/self/oom_score_adj 2>/dev/null || true

while :; do
    "$MODDIR/bin/dsh-launch" >>"$DATA/logs/watchdog.log" 2>&1
    echo "[$(date)] dsh-launch exited: $?" >>"$DATA/logs/watchdog.log"
    sleep 10
done
